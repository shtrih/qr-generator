    files or system fonts). Each glyph is CAPTION_GLYPH_ROWS row bytes,
    top to bottom; bit 0 of a row byte is the leftmost pixel column. Caps
    occupy rows 0..6 (baseline = row 6), x-height letters rows 2..6 and
    descenders row 7. }
  CAPTION_GLYPH_COLS = 5;
  CAPTION_GLYPH_ROWS = 8;
  CAPTION_GLYPH_ADVANCE = 6;  // glyph columns + one blank spacing column
  CAPTION_GLYPH_COUNT = 163;

  { Glyph order: ASCII $20..$7E, then Yo, yo, A..Ya, a..ya, ellipsis, dash. }
  CAPTION_FIRST_ASCII = $20;
  CAPTION_ASCII_COUNT = 95;
  CAPTION_IDX_YO = 95;
  CAPTION_IDX_YO_SMALL = 96;
  CAPTION_IDX_CYR_UPPER = 97;   // A..Ya, 32 glyphs
  CAPTION_IDX_CYR_LOWER = 129;  // a..ya, 32 glyphs
  CAPTION_IDX_ELLIPSIS = 161;
  CAPTION_IDX_DASH = 162;

type
  TCaptionGlyph = array[0..CAPTION_GLYPH_ROWS - 1] of Byte;
  { One caption line / a list of caption lines, as Unicode code points. }
  TCodePointArray = array of Cardinal;
  TCaptionLines = array of TCodePointArray;

