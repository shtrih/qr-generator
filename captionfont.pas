{ Index into CaptionGlyphs for a Unicode code point, -1 when the font has
  no glyph for it (the caller renders such runs with a TrueType fallback
  font instead). }
function CaptionGlyphIndex(ACodePoint: Cardinal): Integer;

{ Encodes one Unicode code point as a UTF-8 string (for handing runs of
  code points the pixel font lacks to TrueType text routines). }
function CaptionCodePointToUtf8(ACh: Cardinal): String;

{ Decodes a UTF-8 string to code points; invalid bytes become $FFFD. }
function Utf8ToCodePoints(const S: String): TCodePointArray;

implementation

function CaptionGlyphIndex(ACodePoint: Cardinal): Integer;
begin
  case ACodePoint of
    $20..$7E:     Result := ACodePoint - $20;
    $0401:        Result := CAPTION_IDX_YO;
    $0451:        Result := CAPTION_IDX_YO_SMALL;
    $0410..$042F: Result := CAPTION_IDX_CYR_UPPER + (ACodePoint - $0410);
    $0430..$044F: Result := CAPTION_IDX_CYR_LOWER + (ACodePoint - $0430);
    $2026:        Result := CAPTION_IDX_ELLIPSIS;
    $2013, $2014: Result := CAPTION_IDX_DASH;
    else          Result := -1;
  end;
end;

function CaptionCodePointToUtf8(ACh: Cardinal): String;
begin
  if ACh < $80 then
    Result := Chr(ACh)
  else if ACh < $800 then
    Result := Chr($C0 or (ACh shr 6)) + Chr($80 or (ACh and $3F))
  else if ACh < $10000 then
    Result := Chr($E0 or (ACh shr 12)) + Chr($80 or ((ACh shr 6) and $3F)) +
      Chr($80 or (ACh and $3F))
  else
    Result := Chr($F0 or (ACh shr 18)) + Chr($80 or ((ACh shr 12) and $3F)) +
      Chr($80 or ((ACh shr 6) and $3F)) + Chr($80 or (ACh and $3F));
end;

function Utf8ToCodePoints(const S: String): TCodePointArray;
var
  I, N, L, J: Integer;
  B, V: Cardinal;

  procedure Push(ACh: Cardinal);
  begin
    Result[N] := ACh;
    Inc(N);
  end;

begin
  Result := nil;
  // worst case: one code point per byte; shrunk at the end
  SetLength(Result, Length(S) + 1);
  N := 0;
  I := 1;
  L := Length(S);
  while I <= L do
  begin
    B := Ord(S[I]);
    if B < $80 then
    begin
      Push(B);
      Inc(I);
    end
    else
    begin
      // multi-byte sequence: 2, 3 or 4 bytes
      if (B and $E0) = $C0 then
      begin
        V := B and $1F;
        J := 2;
      end
      else if (B and $F0) = $E0 then
      begin
        V := B and $0F;
        J := 3;
      end
      else if (B and $F8) = $F0 then
      begin
        V := B and $07;
        J := 4;
      end
      else
        J := 0; // stray continuation byte or $F8..$FF
      if (J >= 2) and (I + J - 1 <= L) then
      begin
        Dec(J);
        Inc(I);
        while J > 0 do
        begin
          B := Ord(S[I]);
          if (B and $C0) <> $80 then
          begin
            J := 0; // not a continuation byte: invalid
            V := $FFFD;
            Break;
          end;
          V := (V shl 6) or (B and $3F);
          Inc(I);
          Dec(J);
        end;
        if V <> $FFFD then
          Push(V)
        else
          Push($FFFD);
      end
      else
      begin
        Push($FFFD); // truncated or stray byte
        Inc(I);
      end;
    end;
  end;
  SetLength(Result, N);
end;

end.
