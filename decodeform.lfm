    Left = 139
    Height = 28
    Top = 11
    Width = 150
    Caption = 'Paste from clipboard'
    TabOrder = 1
  end
  object lblFileName: TLabel
    Left = 297
    Height = 15
    Top = 19
    Width = 236
    Alignment = taRightJustify
    Anchors = [akTop, akLeft, akRight]
