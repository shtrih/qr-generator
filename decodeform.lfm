  object dlgOpenImage: TOpenDialog
    Left = 300
    Top = 16
    Filter = 'All supported images (*.png;*.bmp;*.jpg;*.jpeg)|*.png;*.bmp;*.jpg;*.jpeg|PNG image (*.png)|*.png|Windows bitmap (*.bmp)|*.bmp|JPEG image (*.jpg;*.jpeg)|*.jpg;*.jpeg|All files (*.*)|*.*'
    Options = [ofFileMustExist]
  end
